ENVIRONMENT=development
DEBUG=false
DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5433/habicapital_p2p
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=10
JWT_SECRET_KEY=replace-with-at-least-64-random-characters-before-starting-the-application
PII_ENCRYPTION_KEY=replace-with-base64-of-32-random-bytes
PII_BLIND_INDEX_KEY=replace-with-a-different-base64-of-32-random-bytes
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
ADMIN_EMAIL=admin@habicapital.co
ADMIN_PASSWORD=replace-with-a-unique-strong-admin-password
ADMIN_ALIAS=admin_system
CORS_ORIGINS=["http://localhost:3000"]
